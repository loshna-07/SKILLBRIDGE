{
  "name": "skillbridge-server",
  "version": "1.0.0",
  "description": "SkillBridge Academia-Industry Collaboration Platform Backend",
  "main": "dist/index.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "db:start": "ts-node src/db_service.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "prisma:generate": "prisma generate",
    "prisma:push": "prisma db push",
    "prisma:migrate": "prisma migrate dev",
    "seed:demo": "ts-node src/seed_multi_domain_demo.ts",
    "clear:demo": "ts-node src/clear_demo_data.ts",
    "seed:ayurveda-demo": "ts-node src/seed_multi_domain_demo.ts",
    "clear:ayurveda-demo": "ts-node src/clear_demo_data.ts"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "embedded-postgres": "^18.4.0-beta.17",
    "express": "^4.21.1",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.8.7",
    "prisma": "^5.22.0",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.6.3"
  }
}
