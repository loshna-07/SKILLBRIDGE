# SkillBridge Backend Environment Variables
PORT=5000
NODE_ENV=production

# Database Connection (PostgreSQL)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
# Example (Neon/Supabase/Render): postgresql://skillbridge_user:password@ep-xyz.region.aws.neon.tech/skillbridge?sslmode=require
DATABASE_URL=postgresql://postgres:password@localhost:5432/skillbridge

# JWT Authentication Secret
JWT_SECRET=skillbridge_super_secure_jwt_secret_key_change_in_production

# OTP Authentication Settings
OTP_MODE=production
OTP_EXPIRY_MINUTES=5
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=30
OTP_FROM_EMAIL=no-reply@skillbridge.edu
